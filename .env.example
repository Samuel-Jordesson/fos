# MySQL remoto
DB_HOST=seu-host-mysql.com
DB_PORT=3306
DB_USER=usuario
DB_PASSWORD=senha
DB_NAME=forum
# coloque "true" se o provedor exigir SSL (PlanetScale, Aiven, etc.)
DB_SSL=false

# chave para assinar o login (troque por algo longo e aleatório)
JWT_SECRET=troque-isso-por-uma-chave-bem-grande

# TURN opcional para chamadas
# TURN_URLS=turn:seu-servidor:80,turn:seu-servidor:443?transport=tcp
# TURN_USER=
# TURN_PASS=
